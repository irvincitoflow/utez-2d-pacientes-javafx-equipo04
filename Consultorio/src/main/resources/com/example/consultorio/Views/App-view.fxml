<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.consultorio.controllers.PacienteController">
   <children>
      <GridPane>
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Telefono" GridPane.rowIndex="4" />
            <Label text="Alergias" GridPane.rowIndex="5" />
            <Label text="Edad" GridPane.rowIndex="3" />
            <Label text="Nombre" GridPane.rowIndex="2" />
            <Label text="CURP" GridPane.rowIndex="1" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </children>
      </GridPane>
       <TableView fx:id="tblPacientes" VBox.vgrow="ALWAYS">
           <columns>
               <TableColumn fx:id="colCurp" prefWidth="100.0" text="CURP" />
               <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
               <TableColumn fx:id="colEdad" prefWidth="50.0" text="Edad" />
               <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
               <TableColumn fx:id="colAlergias" prefWidth="100.0" text="Alergias" />
               <TableColumn fx:id="colEstatus" prefWidth="75.0" text="Estatus" />
           </columns>
       </TableView>

       <Label fx:id="lblMsg" text="..." />
   </children>



</VBox>
